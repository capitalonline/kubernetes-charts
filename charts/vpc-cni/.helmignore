# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Golang
vendor/
go.mod
go.sum
*.go
# Build artifacts
*.o
*.a
*.so
dist/
bin/
# Documentation
README.md
*.md
# Test files
test/
*_test.go
# Other files not needed in the chart
Makefile
Dockerfile
PROJECT
hack/
cmd/
pkg/
config/
samples/

